# Copy to .env for local runs. On Railway, set these as service variables instead.

# Postgres in production; leave unset to use SQLite in ./data on a laptop.
# DATABASE_URL=postgresql://user:pass@host:5432/irris

# Encrypts stored secrets (database connection strings, model keys). Required with Postgres. Never change it
# after data is stored, or the stored secrets can't be read.
# SECRET_KEY=

# Reasoning model: any OpenAI-compatible chat API with tool calling. Without a key, the assistant answers
# from search only.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# LLM_API_KEY=

# Vision model: any OpenAI-compatible chat API that takes images, e.g. Ollama on a GPU box:
# VLM_BASE_URL=http://gpu-box:11434/v1
# VLM_MODEL=qwen3.5:2b
# VLM_API_KEY=

# MAX_UPLOAD_MB=50
